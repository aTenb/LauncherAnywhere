<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3334C98B" android:endColor="#221C3D2E" />
            <stroke android:width="2dp" android:color="#FF34C98B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2A242C38" android:endColor="#22181F28" />
            <stroke android:width="1dp" android:color="#334B5563" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
