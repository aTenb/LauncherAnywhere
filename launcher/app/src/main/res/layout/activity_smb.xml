<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0C0F14">

    <!-- Main Content Root -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_smb"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smb_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="@font/outfit_medium" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="正在扫描局域网…"
                    android:textColor="#FF94A3B8"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <!-- Header Action Pills -->
            <TextView
                android:id="@+id/btn_account"
                style="@style/TopButton"
                android:text="切换账号"
                android:visibility="gone"
                android:nextFocusDown="@+id/rv_files" />

            <TextView
                android:id="@+id/btn_scan"
                style="@style/TopButton"
                android:text="刷新扫描"
                android:nextFocusDown="@+id/rv_servers" />

            <TextView
                android:id="@+id/btn_manual"
                style="@style/TopButton"
                android:text="手动连接"
                android:nextFocusDown="@+id/rv_servers" />
        </LinearLayout>

        <!-- Breadcrumbs Navigation Bar (Visible in File Mode) -->
        <HorizontalScrollView
            android:id="@+id/scroll_breadcrumbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/breadcrumb_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Central Display Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="18dp">

            <!-- Discovered Servers Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_servers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <!-- Shares / Files List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_files"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                android:visibility="gone" />

            <!-- Empty / Informational State -->
            <LinearLayout
                android:id="@+id/empty_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_smb_server"
                    android:alpha="0.4"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_empty_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="未发现共享设备，请确保电脑/NAS与电视在同一网络"
                    android:textColor="#FF64748B"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <!-- Loading Spinner State -->
            <LinearLayout
                android:id="@+id/loading_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tv_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="正在读取中…"
                    android:textColor="#FF94A3B8"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Modal Dialog Overlay 1: Server Authentication / Manual Connect -->
    <FrameLayout
        android:id="@+id/auth_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="36dp"
            android:background="@drawable/smb_dialog_bg"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:id="@+id/dialog_auth_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接到共享服务器"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/outfit_medium" />

            <TextView
                android:id="@+id/dialog_auth_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="输入服务器 IP 与账号凭据"
                android:textColor="#FF94A3B8"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_regular" />

            <EditText
                android:id="@+id/edit_server_host"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/smb_input_bg"
                android:hint="服务器 IP 地址 (例: 192.168.1.100)"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF64748B"
                android:textSize="16sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_server_user"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/smb_input_bg"
                    android:hint="用户名 (免密留空)"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FF64748B"
                    android:textSize="16sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <EditText
                    android:id="@+id/edit_server_pass"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/smb_input_bg"
                    android:hint="密码"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FF64748B"
                    android:textSize="16sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cb_remember_creds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:text="记住此设备的登录凭据"
                android:textColor="#FFCBD5E1"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_regular" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_auth_guest"
                    style="@style/TopButton"
                    android:text="访客/免密连接" />

                <TextView
                    android:id="@+id/btn_auth_cancel"
                    style="@style/TopButton"
                    android:text="取消" />

                <TextView
                    android:id="@+id/btn_auth_confirm"
                    style="@style/TopButton"
                    android:text="连接" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Modal Dialog Overlay 2: APK Download Progress -->
    <FrameLayout
        android:id="@+id/download_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/smb_dialog_bg"
            android:orientation="vertical"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_smb_apk"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="正在获取安装包"
                        android:textColor="#FFFFFFFF"
                        android:textSize="20sp"
                        android:fontFamily="@font/outfit_medium" />

                    <TextView
                        android:id="@+id/tv_download_filename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="app.apk"
                        android:textColor="#FF38BDF8"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_regular" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/download_progressbar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="24dp"
                android:progressDrawable="@drawable/smb_progress_horizontal"
                android:max="100"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_download_progress_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0% (0 / 0 MB)"
                    android:textColor="#FF94A3B8"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />

                <TextView
                    android:id="@+id/tv_download_cancel_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按返回键取消"
                    android:textColor="#FF64748B"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_download_cancel"
                style="@style/TopButton"
                android:layout_gravity="end"
                android:layout_marginTop="18dp"
                android:text="取消下载" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
