<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/smb_server_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="20dp">

    <ImageView
        android:id="@+id/img_server_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_smb_server"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_server_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_medium"
            android:singleLine="true"
            android:text="DESKTOP-PC"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_server_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/outfit_regular"
            android:text="192.168.1.100"
            android:textColor="#FF94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_server_auth_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/outfit_regular"
            android:text="访客模式 / 未保存密码"
            android:textColor="#FF34C98B"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
